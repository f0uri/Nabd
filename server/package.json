{
  "name": "nabd-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "خادم GraphQL لتطبيق نبض + تخزين وسائط على تلغرام",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "smoke:persist": "node scripts/persistence-check.js",
    "smoke:sweep": "node scripts/schema-sweep.js",
    "smoke:chat": "node scripts/chat-smoke.js",
    "smoke:flow": "node scripts/chat-flow.js",
    "smoke:rt": "node scripts/realtime-smoke.js",
    "check:docs": "node scripts/validate-mobile-docs.js",
    "smoke:features": "node scripts/features-smoke.js",
    "data:clean": "node scripts/clean-test-data.js",
    "smoke:reels": "node scripts/reels-smoke.js",
    "seed:demo": "node scripts/seed-demo.js",
    "smoke:instagram": "node scripts/instagram-smoke.js",
    "import:instagram": "node scripts/import-instagram.js",
    "smoke:ingest": "node scripts/ingest-smoke.js",
    "prune:reels": "node scripts/prune-reels.js",
    "ig:check": "node scripts/ig-session-check.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.0",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  }
}
