# ===== خادم نبض =====
PORT=4000

# سرّ توقيع توكنات الدخول (JWT). بدّلو بقيمة عشوائية طويلة في الإنتاج:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ===== تخزين الوسائط على تلغرام =====
# 1) افتح @BotFather في تلغرام → /newbot → خُد التوكن
# 2) أرسل رسالة واحدة على الأقل للبوت من حسابك (اعرف الـ ID من @userinfobot)
#    وإلا سيظهر الخطأ: "chat not found" أو "bot can't initiate conversation"
# 3) املأ القيمتين أسفله
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# telegram (افتراضي إذا كانت القيمتان موجودتين) أو local
MEDIA_PROVIDER=telegram

UPLOAD_DIR=uploads

# ---- قاعدة البيانات (PostgreSQL) ----
# خليه فارغ باش تستعمل PGlite (PostgreSQL مدمج، البيانات فـ ./data/pg)
# ولا حط رابط سيرفر حقيقي:
# DATABASE_URL=postgres://nabd:nabd@localhost:5432/nabd
DATABASE_URL=

# ---- الترجمة (اختياري) ----
# بلا إعداد: كيتستعمل Google (gtx) ومن بعد MyMemory تلقائياً.
# إلا بغيت مزوّد خاص (LibreTranslate مثلاً: docker run -p 5000:5000 libretranslate/libretranslate):
# TRANSLATE_URL=http://localhost:5000/translate
# TRANSLATE_KEY=
TRANSLATE_URL=

# ---- التحديث اللحظي (WebSocket) ----
# كيخدم على نفس البورت: ws://<host>:4000/ws?token=<JWT> — ما يحتاج حتى إعداد.

# ===== الجلب التلقائي لريلز إنستغرام (بلا تدخل من المستخدم) =====
# 1 = شغّال (افتراضي) · 0 = مطفي
IG_AUTO_IMPORT=1
# اختياري 100%: كاينة قوائم افتراضية مدمجة فالكود (15 حساب + 12 موضوع)،
# هادو غير إلا بغيتي تبدّلهم بحسابات/مواضيع أخرى:
# IG_ACCOUNTS=nasa,natgeo,visitmorocco
# IG_TOPICS=marrakech,morocco,food,travel
# كل شحال دورة (دقايق) · شحال ريل فالدورة · سقف يومي
IG_INTERVAL_MINUTES=45
IG_MAX_PER_CYCLE=3
IG_MAX_PER_DAY=30
# اختياري: Graph API الرسمي ديال إنستغرام (أضمن قناة فالإنتاج)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_MAX_MB=18

# ===== جلسة إنستغرام بالكوكيز =====
# ⚠️ ما تحتاجش تحطها هنا! دخل من التطبيق: القائمة ← الإدارة ← لوحة الأدمن
#    ولصق sessionid=…; csrftoken=…; ds_user_id=… ثم «حفظ واختبار».
#    الكوكيز كتتحفظ فقاعدة البيانات (app_settings.ig_session) وكتتقرى فكل دورة.
# هاد المتغيرات بقاو غير كقيمة ابتدائية (seed) للخادم ملي كيتشغّل أول مرة، ولوحة
# الأدمن كتغلبهم دايماً. سايبهم خاويين = نضيف.
IG_SESSION_ID=
IG_CSRFTOKEN=
IG_DS_USER_ID=
