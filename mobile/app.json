{
  "expo": {
    "name": "نبض",
    "slug": "fysbwk",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#08090B",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nabd.social",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "app.nabd.social",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 3
    },
    "extra": {
      "rtl": true,
      "apiUrl": "http://localhost:4000/graphql",
      "eas": {
        "projectId": "eec41206-1069-4604-aa2a-3fcc812f1ecd"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-video",
      "./plugins/withCompactAndroid.cjs"
    ],
    "icon": "./assets/icon.png"
  }
}
