# عنوان الخادم (GraphQL) — بدّلو ملي تبني APK ولا كتجرب على تيليفون حقيقي
# فالمحاكي (Android emulator): http://10.0.2.2:4000/graphql
# فتيليفون فـنفس الشبكة: http://<IP-ديال-الماكينة>:4000/graphql
# فالإنتاج: https://api.your-domain.com/graphql
EXPO_PUBLIC_API_URL=http://localhost:4000/graphql

# OTA updates: optional override of the public project ID already linked in app.json.
# Leave empty to use the linked project. Changing it requires matching Expo slug and a new APK.
# Publication tokens belong ONLY in GitHub Secrets, never in this file.
EXPO_EAS_PROJECT_ID=

# Explicit experimental direct mode, WITHOUT a backend. Default stays auto.
# Read docs/telegram-hosting.md FIRST. Never reuse another app's bot or data.
# WARNING: These two fields are extractable from the APK/OTA even via GH Secrets.
EXPO_PUBLIC_DATA_SOURCE=auto
EXPO_PUBLIC_TELEGRAM_BOT_TOKEN=
EXPO_PUBLIC_TELEGRAM_CHAT_ID=
