      "display": "'Noto Kufi Arabic', System, -apple-system, sans-serif",
      "mono": "'SF Mono', ui-monospace, Menlo, monospace"
    },
    "scale": {
      "caption": { "size": 11, "lineHeight": 14, "weight": 400 },
      "micro": { "size": 12, "lineHeight": 16, "weight": 400 },
