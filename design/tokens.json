    "tracking": { "tight": -0.2, "normal": 0, "wide": 0.2 }
  },
  "elevation": {
    "none": { "value": "none" },
    "card": { "value": { "shadowColor": "#000", "shadowOpacity": 0.06, "shadowRadius": 8, "shadowOffset": [0, 2], "elevation": 2 } },
    "raised": { "value": { "shadowColor": "#000", "shadowOpacity": 0.12, "shadowRadius": 16, "shadowOffset": [0, 6], "elevation": 6 } },
    "appBar": { "value": { "shadowColor": "#000", "shadowOpacity": 0.08, "shadowRadius": 4, "shadowOffset": [0, 1], "elevation": 3 } }
  },
  "motion": {
    "duration": { "instant": 80, "fast": 140, "normal": 220, "slow": 320, "skeleton": 1100 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "decelerate": [0, 0, 0, 1],
      "spring": { "damping": 14, "stiffness": 220, "mass": 0.6 }
    },
    "shimmer": { "from": -1, "to": 1, "loop": true }
  },
  "layout": {
    "gutter": { "value": 16 },
    "cardGap": { "value": 8 },
    "contentMaxWidth": { "value": 680 },
    "safeAreaBottom": { "value": 34 }
